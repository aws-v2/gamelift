# Application Environment (dev, prod)
# This dictates the NATS subject prefixes (e.g., dev.s3.v1.game.stored vs prod.s3.v1.game.stored)
APP_ENV=dev
SERVER_PORT=:8091
PUBLIC_URL=http://localhost:8091
DEBUG_MODE=true

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=gamelift_db

# Fallback SQLite DB (if Postgres fails)
SQLITE_PATH=gamelift_fallback.db

# Messaging Configuration (NATS)
NATS_URL=nats://127.0.0.1:4222
# Uncomment to use authentication
NATS_USER=auth-server
NATS_PASSWORD=auth-secret

# JWT Authentication
JWT_EXPIRATION_MS=86400000

# Godot Game Server
GODOT_PATH=/usr/local/bin/godot

# Eureka Discovery Client
EUREKA_APP_NAME=gamelift-server
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_HOSTNAME=localhost
EUREKA_IP_ADDR=127.0.0.1
EUREKA_PORT=8091
